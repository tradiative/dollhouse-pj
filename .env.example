# Separate API billing is OFF by default. This does not use a ChatGPT subscription.
# Enable only after an explicit choice of the separate API billing route.
TRADIATIVE_ALLOW_SEPARATE_API=false
# Optional server credential; never use a VITE_ variable.
TRADIATIVE_AI_KEY=
TRADIATIVE_AI_MODEL=gpt-4.1-mini
PORT=3000
# Official PERSONAL execution alternative only. Remains disabled on the public site.
# This is not authorization for a remotely hosted SIWC app.
TRADIATIVE_CHATGPT_MODE=disabled
# App-owned OAuth files default to the user's .config/tradiative-studio directory.
# TRADIATIVE_AUTH_DIR=/an/owner-only/directory
